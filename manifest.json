{
    "manifest_version": 3,
    "name": "LMS SCORM Auto-Skipper",
    "author": "~the MF's",
    "version": "1.0",
    "description": "Automatically fast-forwards and completes SCORM learning modules.",
    "permissions": [
        "scripting",
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}